# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional hosted lobby/signaling service. Leave unset when the game and its
# multiplayer server share an origin (the local `npm run dev` default).
VITE_MULTIPLAYER_SIGNALING_URL=""
# Friends uses the controlled HTTP service by default, including same-origin.
# Static hosts must deploy that service and configure its HTTPS origin above.
# Explicit legacy MQTT compatibility (unqualified for Friends reliability):
# VITE_FRIENDS_SIGNALING_MODE="broker"
# TURN REST credentials are generated per request and expire after ten minutes.
# Configure the same shared secret in coturn (`static-auth-secret`). Never put
# a permanent TURN username/password in the browser or this file.
TURN_URLS="turn:turn.example.com:3478?transport=udp"
TURN_SHARED_SECRET=""
# Set only after deploying a shared room store plus sticky routing.
MULTIPLAYER_SHARED_ROOM_STORE="false"
